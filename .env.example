# PROMO_INTERVAL_MIN=10     # a cada quantos minutos ler os canais de promoção
# DROP_PCT=5                # queda mínima (%) para avisar quando não há preço alvo
# DB_PATH=data/price_monitor.db
# ML_ACCESS_TOKEN=          # token da API do Mercado Livre (veja README)
